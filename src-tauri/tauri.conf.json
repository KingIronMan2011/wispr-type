{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wispr Type",
  "version": "0.1.0",
  "identifier": "com.wisprtype.desktop",
  "build": {
    "beforeDevCommand": "pnpm run dev:frontend",
    "beforeBuildCommand": "pnpm run build:frontend",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wispr Type",
        "width": 1120,
        "height": 850,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": { "wix": { "language": "en-US" } }
  }
}
